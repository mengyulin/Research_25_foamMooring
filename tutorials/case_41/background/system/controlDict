FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs            (overset fvMotionSolvers sixDoFMooring);

application     overInterDyMFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         9.6;

deltaT          5e-4;

adjustTimeStep  yes;

writeControl    adjustableRunTime; // adjustable; timeStep;

writeInterval   0.2;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes; //no;

adjustTimeStep  yes;

maxCo           0.30; //0.5; // 5.0
maxAlphaCo      0.25; //0.5; // 2.0
maxDeltaT       0.002; //0.01;

functions
